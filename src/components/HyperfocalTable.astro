---
import { CAMERA_DATABASE } from '../data/cameras';

const tableFocals = [14, 16, 18, 20, 24, 28, 35, 50, 70, 85, 105, 135, 200];
const tableApertures = [1.4, 2.0, 2.8, 4.0, 5.6, 8.0, 11.0, 16.0, 22.0];
---

<div class="glass-panel hyperfocal-section" id="hyperfocal-table-section">
  <div class="hyper-header">
    <div>
      <div class="badge badge-purple" data-i18n="hyp.title">Landscape & Astrophotography</div>
      <h3 class="hyper-title" data-i18n="hyp.title">Dynamic Hyperfocal Distance Matrix</h3>
      <p class="hyper-desc" data-i18n="hyp.desc">
        Focus your lens at the <strong>Hyperfocal Distance (H)</strong> to maximize total sharpness: everything from <strong>half that distance (H / 2) to Infinity (∞)</strong> will be in crisp focus.
      </p>
    </div>

    <!-- Actions -->
    <div class="hyper-actions">
      <button type="button" class="btn-action" id="btn-print-table">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect width="12" height="8" x="6" y="14"/></svg>
        <span data-i18n="hyp.btn_print">Print Cheat Sheet</span>
      </button>
      <button type="button" class="btn-action" id="btn-export-csv">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        <span data-i18n="hyp.btn_csv">Export CSV</span>
      </button>
    </div>
  </div>

  <!-- Camera Selector for Table -->
  <div class="table-camera-bar">
    <label>Generate Chart for Camera Sensor:</label>
    <select id="table-camera-select" class="custom-select table-cam-select">
      {CAMERA_DATABASE.map(c => (
        <option value={c.id} data-coc={c.coc} selected={c.id === 'canon-full-frame'}>{c.name}</option>
      ))}
    </select>
  </div>

  <!-- Matrix Table -->
  <div class="table-responsive-wrapper" id="printable-table-area">
    <table class="hyperfocal-table mono" id="matrix-table">
      <thead>
        <tr>
          <th class="th-focal">Focal Length (mm)</th>
          {tableApertures.map(ap => (
            <th>f/{ap}</th>
          ))}
        </tr>
      </thead>
      <tbody id="matrix-table-body">
        {tableFocals.map(f => (
          <tr data-focal={f}>
            <td class="td-focal"><strong>{f} mm</strong></td>
            {tableApertures.map(ap => {
              // Default Full Frame coc = 0.030
              const hMeters = ((f * f) / (ap * 0.030) + f) / 1000;
              return <td data-focal={f} data-aperture={ap}>{hMeters.toFixed(2)} m</td>;
            })}
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="table-footer-notes">
    <div class="note-item">
      <span class="note-icon">💡</span>
      <span><strong>Pro Landscape Tip:</strong> When shooting night skies or landscapes at f/8 with a 24mm lens on Full Frame, focus at <strong>2.41 meters</strong>. Everything from <strong>1.2 meters to the stars at infinity</strong> will be razor sharp!</span>
    </div>
  </div>
</div>

<style>
  .hyperfocal-section {
    padding: 1.75rem;
    margin-top: 1.5rem;
  }

  .hyper-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1.25rem;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .hyper-title {
    font-size: 1.35rem;
    font-weight: 700;
    margin-top: 0.35rem;
  }

  .hyper-desc {
    font-size: 0.88rem;
    color: var(--text-secondary);
    max-width: 750px;
    margin-top: 0.25rem;
  }

  .hyper-actions {
    display: flex;
    gap: 0.5rem;
  }

  .btn-action {
    background: var(--bg-input);
    border: 1px solid var(--border-subtle);
    color: var(--text-primary);
    padding: 0.5rem 0.95rem;
    border-radius: var(--radius-md);
    font-size: 0.82rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 0.45rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-action:hover {
    background: rgba(0, 229, 255, 0.15);
    border-color: var(--accent-cyan);
    color: var(--accent-cyan);
  }

  .table-camera-bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
    background: var(--bg-input);
    padding: 0.65rem 1rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
    flex-wrap: wrap;
  }

  .table-camera-bar label {
    font-size: 0.82rem;
    color: var(--text-muted);
    font-weight: 600;
  }

  .table-cam-select {
    max-width: 450px;
  }

  .table-responsive-wrapper {
    overflow-x: auto;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
    background: var(--bg-card);
  }

  .hyperfocal-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.82rem;
    text-align: center;
    background: var(--bg-card);
  }

  .hyperfocal-table th {
    background: var(--bg-input);
    color: var(--accent-cyan);
    padding: 0.75rem 0.5rem;
    border-bottom: 1px solid var(--border-subtle);
    border-right: 1px solid var(--border-subtle);
    font-weight: 700;
    white-space: nowrap;
  }

  .hyperfocal-table td {
    padding: 0.65rem 0.5rem;
    border-bottom: 1px solid var(--border-subtle);
    border-right: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    transition: background 0.15s ease, color 0.15s ease;
  }

  .hyperfocal-table tr:hover td {
    background: var(--accent-cyan-glow);
    color: var(--text-primary);
  }

  .th-focal, .td-focal {
    background: var(--bg-card-hover) !important;
    color: var(--text-primary) !important;
    font-weight: 700 !important;
    text-align: left;
    padding-left: 1rem !important;
    position: sticky;
    left: 0;
    z-index: 2;
    border-right: 2px solid var(--accent-cyan) !important;
  }

  .table-footer-notes {
    margin-top: 1rem;
    padding: 0.85rem 1.15rem;
    background: var(--accent-amber-glow);
    border: 1px solid var(--accent-amber);
    border-radius: var(--radius-md);
    font-size: 0.82rem;
    color: var(--text-secondary);
  }

  .note-item {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
  }

  .note-icon {
    font-size: 1.1rem;
  }
</style>
