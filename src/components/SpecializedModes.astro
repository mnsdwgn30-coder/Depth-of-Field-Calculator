---
---

<div class="glass-panel specialized-section" id="specialized-section">
  <div class="specialized-header">
    <div>
      <div class="badge badge-green" data-i18n="spec.title">Industry Workflows</div>
      <h3 class="specialized-title" data-i18n="spec.title">Specialized Optical Calculators</h3>
      <p class="specialized-desc" data-i18n="spec.desc">High-precision optical tools for Macro Photography, Cinema & Focus Pullers, and Microscope/Machine Vision.</p>
    </div>

    <!-- Sub-tab switcher -->
    <div class="sub-tab-group" id="spec-tabs">
      <button type="button" class="sub-tab-btn active" data-subtab="macro-panel">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/><path d="M11 8v6"/><path d="M8 11h6"/></svg>
        <span data-i18n="spec.tab_macro">Macro 1:1 Engine</span>
      </button>

      <button type="button" class="sub-tab-btn" data-subtab="cinema-panel">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M7 3v18"/><path d="M3 7.5h4"/><path d="M3 12h18"/><path d="M3 16.5h4"/><path d="M17 3v18"/><path d="M17 7.5h4"/><path d="M17 16.5h4"/></svg>
        <span data-i18n="spec.tab_cinema">Cinema & Super 35</span>
      </button>

      <button type="button" class="sub-tab-btn" data-subtab="microscope-panel">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 18h8"/><path d="M3 22h18"/><path d="M14 22a7 7 0 1 0-14 0"/><path d="M9 14h2"/><path d="M9 12a2 2 0 0 1-2-2V6h6v4a2 2 0 0 1-2 2Z"/><path d="M12 6V3a1 1 0 0 0-1-1H9a1 1 0 0 0-1 1v3"/></svg>
        <span data-i18n="spec.tab_microscope">Microscope & Vision</span>
      </button>
    </div>
  </div>

  <!-- 1. MACRO CALCULATOR -->
  <div class="sub-content-panel active" id="macro-panel">
    <div class="spec-grid">
      <div class="spec-controls">
        <div class="form-group">
          <label>Reproduction Magnification (m):</label>
          <div class="mag-presets">
            <button type="button" class="mag-btn" data-mag="0.2">1:5 (0.2x)</button>
            <button type="button" class="mag-btn" data-mag="0.5">1:2 (0.5x)</button>
            <button type="button" class="mag-btn active" data-mag="1.0">1:1 Life Size</button>
            <button type="button" class="mag-btn" data-mag="2.0">2:1 Ultra Macro</button>
            <button type="button" class="mag-btn" data-mag="5.0">5:1 Extreme</button>
          </div>
          <input type="range" id="macro-mag-slider" min="0.1" max="5.0" step="0.05" value="1.0" />
        </div>

        <div class="form-row">
          <div class="form-group">
            <label>Lens Focal Length:</label>
            <input type="number" id="macro-focal" class="custom-input mono" value="100" min="20" max="300" />
          </div>
          <div class="form-group">
            <label>Set Aperture:</label>
            <input type="number" id="macro-aperture" class="custom-input mono" value="8.0" step="0.5" min="1.4" max="45" />
          </div>
        </div>

        <div class="form-group">
          <label>Sensor Circle of Confusion (CoC):</label>
          <select id="macro-coc-select" class="custom-select">
            <option value="0.030">Full Frame 35mm (0.030 mm)</option>
            <option value="0.020">APS-C Sony/Fuji/Nikon (0.020 mm)</option>
            <option value="0.015">Micro Four Thirds (0.015 mm)</option>
            <option value="0.038">Medium Format GFX (0.038 mm)</option>
          </select>
        </div>
      </div>

      <!-- Macro Results -->
      <div class="spec-results">
        <div class="macro-highlight-card">
          <div class="macro-hl-label">Total Depth of Field at 1:1</div>
          <div class="macro-hl-val mono" id="macro-res-dof">0.96 mm</div>
          <div class="macro-hl-sub mono" id="macro-res-microns">960.0 micrometers (µm)</div>
        </div>

        <div class="macro-details-grid">
          <div class="macro-detail-item">
            <span class="md-label">Effective Aperture:</span>
            <span class="md-val mono text-amber" id="macro-res-eff-f">f / 16.0 (2 Stop Light Loss)</span>
          </div>
          <div class="macro-detail-item">
            <span class="md-label">Approx. Working Distance:</span>
            <span class="md-val mono" id="macro-res-wd">200 mm (20 cm)</span>
          </div>
          <div class="macro-detail-item">
            <span class="md-label">Focus Stacking Advice:</span>
            <span class="md-val mono text-cyan" id="macro-res-stacking">Step Size ~ 0.5 mm (~12 slices)</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 2. CINEMA CALCULATOR -->
  <div class="sub-content-panel" id="cinema-panel">
    <div class="spec-grid">
      <div class="spec-controls">
        <div class="form-group">
          <label>Cinema Sensor / Film Format:</label>
          <select id="cinema-sensor-select" class="custom-select">
            <option value="arri-super35">ARRI Super 35 (Alexa 35 / Mini - 27.99 x 19.22mm)</option>
            <option value="arri-lf">ARRI Large Format (Alexa Mini LF - 36.70 x 25.54mm)</option>
            <option value="red-v-raptor">RED V-Raptor 8K VV (40.96 x 21.60mm)</option>
            <option value="cinema-16mm">Super 16mm Film (12.52 x 7.41mm)</option>
            <option value="cinema-35mm-anamorphic">35mm Anamorphic 2.0x Squeeze</option>
          </select>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label>Cinema Lens Focal Length:</label>
            <input type="number" id="cinema-focal" class="custom-input mono" value="35" min="8" max="300" />
          </div>
          <div class="form-group">
            <label>T-Stop (Transmission):</label>
            <input type="number" id="cinema-tstop" class="custom-input mono" value="2.0" step="0.1" min="1.0" max="22" />
          </div>
        </div>

        <div class="form-group">
          <label>Subject Distance (Focus Mark):</label>
          <div class="input-with-unit">
            <input type="number" id="cinema-dist" class="custom-input mono" value="3.0" step="0.1" min="0.5" max="100" />
            <span class="unit-text" id="cinema-dist-unit">m</span>
          </div>
        </div>
      </div>

      <!-- Cinema Results -->
      <div class="spec-results">
        <div class="macro-highlight-card cinema-card-accent">
          <div class="macro-hl-label">Focus Puller In-Focus Range</div>
          <div class="macro-hl-val mono" id="cinema-res-range">2.68 m — 3.41 m</div>
          <div class="macro-hl-sub mono" id="cinema-res-total">Total Depth: 0.73 m (73 cm)</div>
        </div>

        <div class="macro-details-grid">
          <div class="macro-detail-item">
            <span class="md-label">Hyperfocal Focus Mark:</span>
            <span class="md-val mono text-purple" id="cinema-res-hyper">27.8 m</span>
          </div>
          <div class="macro-detail-item">
            <span class="md-label">Horizontal Angle of View:</span>
            <span class="md-val mono" id="cinema-res-haov">43.6°</span>
          </div>
          <div class="macro-detail-item">
            <span class="md-label">Focus Tolerance Band:</span>
            <span class="md-val mono text-green" id="cinema-res-tolerance">± 36.5 cm</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 3. MICROSCOPE & MACHINE VISION -->
  <div class="sub-content-panel" id="microscope-panel">
    <div class="spec-grid">
      <div class="spec-controls">
        <div class="form-row">
          <div class="form-group">
            <label>Numerical Aperture (NA):</label>
            <input type="number" id="micro-na" class="custom-input mono" value="0.40" step="0.05" min="0.05" max="1.45" />
          </div>
          <div class="form-group">
            <label>Objective Magnification (M):</label>
            <input type="number" id="micro-mag" class="custom-input mono" value="20" min="1" max="150" />
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label>Light Wavelength (λ nm):</label>
            <input type="number" id="micro-lambda" class="custom-input mono" value="550" min="350" max="850" />
          </div>
          <div class="form-group">
            <label>Medium Refractive Index (n):</label>
            <select id="micro-n-select" class="custom-select">
              <option value="1.0">Air (n = 1.000)</option>
              <option value="1.333">Water (n = 1.333)</option>
              <option value="1.515">Oil Immersion (n = 1.515)</option>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label>Machine Vision Pixel Pitch (µm):</label>
          <input type="number" id="micro-pixel" class="custom-input mono" value="3.45" step="0.05" min="1.0" max="15.0" />
        </div>
      </div>

      <!-- Microscope Results -->
      <div class="spec-results">
        <div class="macro-highlight-card micro-card-accent">
          <div class="macro-hl-label">Total Depth of Field (Axial)</div>
          <div class="macro-hl-val mono" id="micro-res-total">3.87 µm</div>
          <div class="macro-hl-sub mono" id="micro-res-breakdown">Wave: 3.44 µm | Geometric: 0.43 µm</div>
        </div>

        <div class="macro-details-grid">
          <div class="macro-detail-item">
            <span class="md-label">Abbe Lateral Resolution:</span>
            <span class="md-val mono text-cyan" id="micro-res-resolution">0.84 µm</span>
          </div>
          <div class="macro-detail-item">
            <span class="md-label">Z-Stack Slicing Step:</span>
            <span class="md-val mono text-amber" id="micro-res-zstep">1.9 µm (Nyquist Criterion)</span>
          </div>
        </div>
      </div>
    </div>
  </div>

</div>

<style>
  .specialized-section {
    padding: 1.75rem;
    margin-top: 1.5rem;
  }

  .specialized-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1.5rem;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .specialized-title {
    font-size: 1.35rem;
    font-weight: 700;
    margin-top: 0.35rem;
  }

  .specialized-desc {
    font-size: 0.88rem;
    color: var(--text-secondary);
    max-width: 700px;
    margin-top: 0.25rem;
  }

  .sub-tab-group {
    display: flex;
    gap: 0.35rem;
    background: rgba(13, 19, 32, 0.7);
    padding: 0.3rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
  }

  .sub-tab-btn {
    background: transparent;
    border: none;
    color: var(--text-secondary);
    padding: 0.5rem 0.85rem;
    font-size: 0.85rem;
    font-weight: 600;
    border-radius: var(--radius-sm);
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    transition: all 0.15s ease;
  }

  .sub-tab-btn:hover {
    color: var(--text-primary);
  }

  .sub-tab-btn.active {
    background: rgba(16, 185, 129, 0.2);
    color: var(--accent-green);
    border: 1px solid rgba(16, 185, 129, 0.35);
  }

  .sub-content-panel {
    display: none;
  }

  .sub-content-panel.active {
    display: block;
  }

  .spec-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .spec-controls {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    box-shadow: var(--shadow-card);
  }

  .mag-presets {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
    margin-bottom: 0.5rem;
  }

  .mag-btn {
    background: var(--bg-input);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    padding: 0.3rem 0.6rem;
    font-size: 0.78rem;
    font-family: var(--font-mono);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .mag-btn.active {
    background: var(--accent-green-glow);
    color: var(--accent-green);
    border-color: var(--accent-green);
    font-weight: 700;
  }

  .spec-results {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .macro-highlight-card {
    background: linear-gradient(135deg, var(--accent-green-glow), var(--bg-card));
    border: 1px solid var(--accent-green);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    text-align: center;
    box-shadow: var(--shadow-card);
  }

  .cinema-card-accent {
    background: linear-gradient(135deg, rgba(192, 132, 252, 0.15), var(--bg-card));
    border-color: var(--accent-purple);
  }

  .micro-card-accent {
    background: linear-gradient(135deg, var(--accent-cyan-glow), var(--bg-card));
    border-color: var(--accent-cyan);
  }

  .macro-hl-label {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
  }

  .macro-hl-val {
    font-size: 2.2rem;
    font-weight: 800;
    color: var(--text-primary);
    margin: 0.35rem 0;
  }

  .macro-hl-sub {
    font-size: 0.9rem;
    color: var(--accent-green);
  }

  .macro-details-grid {
    background: var(--bg-input);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .macro-detail-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.85rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .macro-detail-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .md-label {
    color: var(--text-muted);
  }

  .md-val {
    font-weight: 600;
    color: var(--text-primary);
  }

  .text-purple { color: var(--accent-purple); }

  @media (max-width: 860px) {
    .spec-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
